#############################################
#            SANDBOX / TESTS CONFIG         #
#############################################
#
# These variables are used by integration tests against the AEAT sandbox.
# The certificate must be a VALID SANDBOX TEST certificate, NOT a production one.
# Never commit the actual .env file; only commit .env.example.

# Path to your sandbox test certificate (P12/PFX)
# VERIFACTU_CERT_PATH=/path/to/your/sandbox-certificate.p12
# Certificate password
# VERIFACTU_CERT_PASSWORD=your_certificate_password
# Certificate type: 'certificate' or 'seal'
VERIFACTU_CERT_TYPE=certificate
# Environment must be 'sandbox' for integration tests
VERIFACTU_ENVIRONMENT=sandbox

# Required by integration tests (must match AEAT census data)
TEST_ISSUER_NIF=B12345678
TEST_ISSUER_NAME="Example Company SL"

#############################################
#          PRODUCTION CONFIG (AEAT)         #
#############################################
#
# Uncomment and adjust these for production use.
# Do NOT use production credentials in your .env file for testing.

# VERIFACTU_CERT_PATH=/path/to/your/production-certificate.p12
# VERIFACTU_CERT_PASSWORD=your_production_password
# VERIFACTU_CERT_TYPE=certificate
# VERIFACTU_ENVIRONMENT=production
